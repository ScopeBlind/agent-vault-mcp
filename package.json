    "@noble/hashes": "^2.0.1"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "INSTALL_FOR_AGENTS.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  }
