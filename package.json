{
  "name": "@scopeblind/agent-vault-mcp",
  "version": "0.1.0",
  "description": "MCP adapter for ScopeBlind Agent Vault: signed context capsules, memory proposals, and offline verification for Hermes/GBrain-style agents.",
  "type": "module",
  "license": "MIT",
  "author": "ScopeBlind Pty Ltd",
  "homepage": "https://scopeblind.com/agent-vault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScopeBlind/agent-vault-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ScopeBlind/agent-vault-mcp/issues"
  },
  "keywords": [
    "mcp",
    "agent",
    "memory",
    "verification",
    "receipts",
    "scopeblind",
    "hermes",
    "gbrain",
    "context-capsule"
  ],
  "bin": {
    "scopeblind-agent-vault-mcp": "src/index.mjs"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
